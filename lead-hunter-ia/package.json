{
  "name": "lead-hunter-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Lead Hunter IA - busca local e ética de leads comerciais com potencial para agentes de IA.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "web": "tsx src/server/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pomodoro": "tsx src/workflow/pomodoro.js"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@inquirer/prompts": "^7.2.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^3.4.0",
    "express": "^4.22.2",
    "p-limit": "^6.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
