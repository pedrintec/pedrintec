# =====================================================================
# Lead Hunter IA - variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# =====================================================================

# Caminho do banco SQLite local (relativo à raiz do projeto)
DATABASE_PATH=./data/lead-hunter.db

# ---------------------------------------------------------------------
# PROVEDOR DE BUSCA
# Opções: manual | serpapi | serper | serper_places | exa | duckduckgo | multi | google_cse
#   multi          -> MULTI-ROBÔ: dispara todos os provedores com chave
#                     configurada EM PARALELO e mescla/deduplica (recomendado).
#                     DuckDuckGo entra SEMPRE (é grátis, sem chave).
#   duckduckgo     -> GRATUITO, sem chave. Raspagem leve do HTML público de
#                     resultados (não é API oficial; pode quebrar se a DDG
#                     mudar o HTML, mas hoje funciona bem e sem cota).
#   serpapi        -> SerpAPI (https://serpapi.com)
#   serper         -> Serper (https://serper.dev) - busca orgânica do Google
#   serper_places  -> Serper /places: empresas locais (telefone/endereço/rating)
#   exa            -> Exa (https://exa.ai) - busca neural, robô extra do multi
#   google_cse     -> Google Custom Search - GRATUITO até 100 buscas/dia
#                     (crie em https://programmablesearchengine.google.com)
#   manual         -> NÃO consulta API. Gera os dorks/URLs para você abrir.
# ---------------------------------------------------------------------
SEARCH_PROVIDER=multi

# --- SerpAPI ---
SERPAPI_KEY=

# --- Serper (2º robô de busca; pegue a chave em https://serper.dev) ---
SERPER_API_KEY=

# --- Exa (3º robô de busca; pegue a chave em https://dashboard.exa.ai -> API Keys) ---
EXA_API_KEY=

# --- Google Custom Search (se SEARCH_PROVIDER=google_cse) ---
# Crie a engine em https://programmablesearchengine.google.com (pegue o "cx")
# e a API key em https://console.cloud.google.com (Custom Search API)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Google Places API (provider futuro/oficial, opcional) ---
GOOGLE_PLACES_KEY=

# ---------------------------------------------------------------------
# COMPORTAMENTO DE SCRAPING / CONFORMIDADE
# ---------------------------------------------------------------------
# User-Agent identificado (boa prática ética: identifique seu bot)
USER_AGENT=LeadHunterIA/0.1 (+https://example.com/bot; contato@example.com)

# Atraso mínimo entre requisições ao MESMO host (ms)
REQUEST_DELAY_MS=1500

# Máximo de requisições simultâneas (global)
MAX_CONCURRENCY=3

# Timeout por requisição (ms)
REQUEST_TIMEOUT_MS=15000

# Tentativas em caso de falha de rede (além da primeira)
MAX_RETRIES=2

# Respeitar robots.txt antes de raspar uma página? (true/false)
RESPECT_ROBOTS_TXT=true

# Usar Playwright como fallback para páginas que dependem de JS? (true/false)
# Requer: npm i playwright && npx playwright install chromium
USE_PLAYWRIGHT_FALLBACK=false

# TTL do cache de robots.txt (horas)
ROBOTS_CACHE_TTL_HOURS=24

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# País padrão para as buscas (ISO ou nome) - usado em alguns provedores
DEFAULT_COUNTRY=Brasil

# ---------------------------------------------------------------------
# PROSPECÇÃO CONSULTIVA / LGPD
# ---------------------------------------------------------------------
# Base legal padrão (LGPD): legitimo_interesse_comercial | dados_publicos_comerciais
#                           | consentimento | importado_pelo_usuario
DEFAULT_LEGAL_BASIS=legitimo_interesse_comercial

# Incluir leads com opt-out nas exportações? (padrão: false)
EXPORT_INCLUDE_OPT_OUT=false

# Gerar mensagem de abordagem automática por lead? (true/false)
GENERATE_OUTREACH_MESSAGES=true

# Gerar estimativa de ROI por lead? (true/false)
GENERATE_ROI_ESTIMATE=true

# ---------------------------------------------------------------------
# INTEGRAÇÕES (opcional)
# ---------------------------------------------------------------------
# Webhook n8n disparado a cada mudança de etapa do funil (§6c).
# Deixe vazio para desativar. Payload POST (JSON):
#   { lead_id, name, old_stage, new_stage, score, temp, at }
N8N_WEBHOOK_URL=

# --- IA do Pesquisador/SDR (opcional) ---
# Com a chave, o Pesquisador e o SDR usam o Claude (relatórios e mensagens
# muito mais inteligentes). Sem a chave, tudo funciona no modo heurístico local.
# Chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo: claude-sonnet-5 (qualidade, padrão) | claude-haiku-4-5-20251001 (econômico p/ volume)
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------
# IA COMERCIAL (Gemini) - SERVER-SIDE apenas. NUNCA colocar no frontend.
# Sem GEMINI_API_KEY, a area "IA Comercial" fica desativada com aviso
# amigavel e o restante do Hunter continua funcionando normalmente.
# Chave em https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=
# Modelo (fallback seguro para gemini-2.5-flash se vazio)
GEMINI_MODEL=gemini-2.5-flash
# Timeout por chamada (ms) e teto de leads por análise em lote
GEMINI_TIMEOUT_MS=45000
AI_BATCH_MAX=10
